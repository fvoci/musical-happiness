{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run i18n && vite",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/paraglide --strategy globalVariable baseLocale --silent",
    "i18n:keys": "node tools/i18n/check-keys.ts",
    "fonts": "node tools/fonts/build.ts",
    "licenses": "node tools/licenses/check.ts",
    "names": "node tools/names/check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm run i18n && openapi-typescript ../../contracts/openapi.json -o src/lib/api/contract.ts --check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && eslint . && prettier --check . && node tools/licenses/check.ts && node tools/names/check.ts && node tools/i18n/check-keys.ts && node tools/lint/check-lengths.ts",
    "lengths:measure": "node tools/lint/measure-lengths.ts",
    "test": "pnpm run i18n && node tools/test-zones.ts",
    "build": "pnpm run i18n && node tools/fonts/build.ts && vite build",
    "preview": "node tools/preview.ts",
    "e2e": "playwright test",
    "e2e:apple": "playwright test --config playwright.apple.config.ts",
    "storybook": "pnpm run i18n && storybook dev --port 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "pnpm run i18n && storybook build --output-dir storybook-static",
    "storybook:site": "node tools/fonts/build.ts && pnpm run build-storybook && node tools/storybook/site.ts",
    "storybook:deploy": "node tools/storybook/wrangler.ts deploy",
    "storybook:preview": "node tools/storybook/wrangler.ts preview",
    "spikes": "pnpm run i18n && vite --config vite.spikes.config.ts",
    "spikes:build": "pnpm run i18n && vite build --config vite.spikes.config.ts",
    "spikes:e2e": "pnpm run i18n && playwright test --config playwright.spikes.config.ts",
    "test:once": "pnpm run i18n && vitest run",
    "look": "pnpm run build && pnpm run spikes:build && pnpm run build-storybook && node tools/serve.ts --host 0.0.0.0 --port 18410 app:app=dist screens=dist-spikes storybook=storybook-static",
    "api:types": "openapi-typescript ../../contracts/openapi.json -o src/lib/api/contract.ts",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "e2e:live:apple": "playwright test --config playwright.live.apple.config.ts",
    "test:storybook": "pnpm run build-storybook && node tools/storybook/site.ts && playwright test --config playwright.storybook.config.ts"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@fvoci/rhwp-studio": "workspace:*",
    "@rhwp/core": "0.9.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-blockquote": "3.34.0",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-code-block": "3.34.0",
    "@tiptap/extension-collaboration": "3.34.0",
    "@tiptap/extension-collaboration-caret": "3.34.0",
    "@tiptap/extension-document": "3.34.0",
    "@tiptap/extension-hard-break": "3.34.0",
    "@tiptap/extension-heading": "3.34.0",
    "@tiptap/extension-horizontal-rule": "3.34.0",
    "@tiptap/extension-italic": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-strike": "3.34.0",
    "@tiptap/extension-text": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "@tiptap/y-tiptap": "3.3.0",
    "docx-preview": "0.4.1",
    "highlight.js": "11.11.1",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "marked": "18.2.0",
    "mermaid": "12.3.0",
    "pdfjs-dist": "6.5.438",
    "saxes": "6.0.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.73.0",
    "@playwright/test": "1.65.1",
    "@storybook/svelte": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "bits-ui": "2.21.0",
    "cldr-annotations-derived-full": "49.0.0",
    "cldr-annotations-full": "49.0.0",
    "cn": "0.5.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-svelte": "1.8.1",
    "storybook": "10.6.7",
    "subset-font": "2.9.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-sonner": "1.2.3",
    "tailwind-variants": "4.0.2",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
