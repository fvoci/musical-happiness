{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run i18n && vite",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/paraglide --strategy globalVariable baseLocale --silent",
    "i18n:convert": "node tools/i18n/convert.ts",
    "i18n:keys": "node tools/i18n/check-keys.ts",
    "fonts": "node tools/fonts/build.ts",
    "licenses": "node tools/licenses/check.ts",
    "names": "node tools/names/check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm run i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && eslint . && prettier --check . && node tools/licenses/check.ts && node tools/names/check.ts && node tools/i18n/convert.ts --check && node tools/i18n/check-keys.ts",
    "test": "pnpm run i18n && node tools/test-zones.ts",
    "build": "pnpm run i18n && node tools/fonts/build.ts && vite build",
    "preview": "node tools/preview.ts",
    "e2e": "playwright test",
    "storybook": "pnpm run i18n && storybook dev --port 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "pnpm run i18n && storybook build --output-dir storybook-static",
    "spikes": "pnpm run i18n && vite --config vite.spikes.config.ts",
    "spikes:build": "pnpm run i18n && vite build --config vite.spikes.config.ts",
    "spikes:e2e": "pnpm run i18n && playwright test --config playwright.spikes.config.ts",
    "test:once": "pnpm run i18n && vitest run",
    "look": "pnpm run build && pnpm run spikes:build && pnpm run build-storybook && node tools/serve.ts --host 0.0.0.0 --port 18410 app:app=dist screens=dist-spikes storybook=storybook-static"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-code": "3.33.0",
    "@tiptap/extension-code-block": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-hard-break": "3.33.0",
    "@tiptap/extension-heading": "3.33.0",
    "@tiptap/extension-horizontal-rule": "3.33.0",
    "@tiptap/extension-italic": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extension-strike": "3.33.0",
    "@tiptap/extension-text": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/suggestion": "3.33.0",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.6.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.70.0",
    "@playwright/test": "1.65.0",
    "@storybook/svelte": "10.6.6",
    "@storybook/svelte-vite": "10.6.6",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "bits-ui": "2.20.6",
    "cn": "0.5.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-svelte": "1.8.0",
    "storybook": "10.6.6",
    "subset-font": "2.9.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-sonner": "1.2.3",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
