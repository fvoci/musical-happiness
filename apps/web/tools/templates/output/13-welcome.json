    {
      "id": "cq1gmiwhx4jgd7q9ad9c1icasqr",
      "type": "card",
      "title": "Share cards on Channels",
      "fields": {
        "icon": "📮",
        "isTemplate": false,
        "properties": {
          "a972dc7a-5f4c-45d2-8044-8c28c69717f1": "af3p8ztcyxgn8wd9z4az7o9tjeh",
          "acypkejeb5yfujhj9te57p9kaxw": "ascd7nm9r491ayot8i86g1gmgqw"
        }
      },
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Cards can be linked and shared with teammates directly on Channels. Card previews are displayed when shared on Channels, so your team can discuss work items and get the relevant context without having to switch over to fvoci."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "To share a card, you'll need to copy the card link first. You can:"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Open a card and select the options menu button at the top right of the card."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Open the board view and hover your mouse over any card to access the options menu button."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "After you've copied the link, paste it into any channel or Direct Message to share the card. A preview of the card will display within the channel with a link back to the card on fvoci."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cse6a9d81tfyd7e34cbmfttbgte",
