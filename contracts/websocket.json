{
  "description": "The messages of the websocket endpoint /ws, as the server reads and sends them; contracts/websocket.md says who sends which and when. A member's value is a JSON type (\"string\", \"boolean\", \"integer\"), the name of a schema of contracts/openapi.json after a \"#\" (\"#Block\"), an object of members for an inline object, or a list of one of these for a JSON list of it. Every member listed is always there, and no other is, but for those a message's \"optional\" names, which websocket.md says when it has; of the commands' members, websocket.md says which may be left out (readToken, epoch, stateVector). A command's \"session\" says whether the connection needs a signed-in session for it; a message's \"sent\": false says the server never sends it today. crates/server/tests/api/websocket.rs and rooms_contract.rs (the DOC_ messages) compare the messages the server sends with this file; the commands are not checked by a test. \"frame\" is the layout of a binary frame, in both directions: its parts in order, each a varuint of lib0 unless it says otherwise.",
  "commands": {
    "SUBSCRIBE_WORKSPACE": {
      "session": true,
      "members": {
        "action": "string",
        "workspaceId": "string"
      }
    },
    "UNSUBSCRIBE_WORKSPACE": {
      "session": true,
      "members": {
        "action": "string",
        "workspaceId": "string"
      }
    },
    "SUBSCRIBE_BLOCKS": {
      "session": false,
      "members": {
        "action": "string",
        "workspaceId": "string",
        "readToken": "string",
        "blockIds": [
          "string"
        ]
      }
    },
    "UNSUBSCRIBE_BLOCKS": {
      "session": false,
      "members": {
        "action": "string",
        "workspaceId": "string",
        "readToken": "string",
        "blockIds": [
          "string"
        ]
      }
    },
    "JOIN_DOC": {
      "session": true,
      "members": {
        "action": "string",
        "workspaceId": "string",
        "cardId": "string",
        "epoch": "integer",
        "stateVector": "string"
      }
    },
    "LEAVE_DOC": {
      "session": true,
      "members": {
        "action": "string",
        "doc": "integer"
      }
    },
    "SET_PRESENCE": {
      "session": false,
      "members": {
        "action": "string",
        "workspaceId": "string",
        "containerId": "string",
        "cardId": "string",
        "readToken": "string"
      }
    },
    "PING": {
      "session": false,
      "members": {
        "action": "string"
      }
    }
  },
  "messages": {
    "UPDATE_CONTAINER": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "container": "#Container"
      }
    },
    "UPDATE_BLOCK": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "block": "#Block",
        "summary": {
          "hasBody": "boolean",
          "tasksTotal": "integer",
          "tasksDone": "integer",
          "preview": "#CardPreview"
        }
      },
      "optional": [
        "summary"
      ]
    },
    "UPDATE_MEMBER": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "member": "#ContainerMember"
      }
    },
    "DELETE_MEMBER": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "member": "#ContainerMember"
      }
    },
    "UPDATE_CATEGORY": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "category": "#Category"
      }
    },
    "UPDATE_CONTAINER_CATEGORY": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "containerCategories": [
          {
            "containerId": "string",
            "categoryId": "string",
            "hidden": "boolean"
          }
        ]
      }
    },
    "REORDER_CATEGORIES": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "categoryOrder": [
          "string"
        ]
      }
    },
    "REORDER_CATEGORY_CONTAINERS": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "categoryId": "string",
        "containerOrder": [
          "string"
        ]
      }
    },
    "UPDATE_CLIENT_CONFIG": {
      "members": {
        "action": "string",
        "clientConfig": "#ClientConfig"
      },
      "sent": false
    },
    "UNSUBSCRIBED_WORKSPACE": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "reason": "string"
      }
    },
    "UNSUBSCRIBED_BLOCKS": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "blockIds": [
          "string"
        ],
        "reason": "string"
      }
    },
    "UPDATE_NOTIFICATIONS": {
      "members": {
        "action": "string"
      }
    },
    "DOC_JOINED": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "cardId": "string",
        "doc": "integer",
        "epoch": "integer",
        "mode": "string"
      }
    },
    "DOC_REFUSED": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "cardId": "string",
        "reason": "string"
      }
    },
    "DOC_ACK": {
      "members": {
        "action": "string",
        "doc": "integer",
        "epoch": "integer",
        "seq": "integer"
      }
    },
    "DOC_NACK": {
      "members": {
        "action": "string",
        "doc": "integer",
        "epoch": "integer",
        "reason": "string"
      }
    },
    "DOC_MODE": {
      "members": {
        "action": "string",
        "doc": "integer",
        "mode": "string"
      }
    },
    "DOC_RESET": {
      "members": {
        "action": "string",
        "doc": "integer",
        "epoch": "integer"
      }
    },
    "DOC_LEFT": {
      "members": {
        "action": "string",
        "doc": "integer",
        "reason": "string"
      }
    },
    "UPDATE_PRESENCE": {
      "members": {
        "action": "string",
        "workspaceId": "string",
        "containerId": "string",
        "people": [
          {
            "userId": "string",
            "cardIds": [
              "string"
            ]
          }
        ],
        "anonymousCount": "integer",
        "hiddenCount": "integer"
      }
    },
    "PONG": {
      "members": {
        "action": "string"
      }
    }
  },
  "frame": [
    {
      "name": "doc",
      "is": "the room, as DOC_JOINED named it"
    },
    {
      "name": "kind",
      "is": "0: a sync message, 1: carets; a frame of another kind is dropped"
    },
    {
      "name": "epoch",
      "is": "which making of the document the frame is about"
    },
    {
      "name": "sync",
      "is": "of a sync message only (a frame of carets has none): 0: step 1 (a state vector), 1: step 2 (what the receiver is missing), 2: update"
    },
    {
      "name": "length",
      "is": "of the payload"
    },
    {
      "name": "payload",
      "is": "bytes, to the end of the frame: a Yjs state vector or update, version 1; of carets, an awareness update of y-protocols"
    }
  ]
}
