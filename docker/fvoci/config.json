{
    "serverRoot": "http://localhost:8000",
    "port": 8000,
    "dbtype": "sqlite3",
    "dbconfig": "/data/fvoci.db",
    "useSSL": false,
    "webpath": "/opt/fvoci/web",
    "filesdriver": "local",
    "filespath": "/data/files",
    "session_idle_days": 14,
    "session_max_days": 90,
    "localOnly": false,
    "enableLocalMode": true,
    "localModeSocketLocation": "/var/tmp/fvoci_local.socket",
    "prometheusaddress": ""
}
